# server/.env

PORT=4000

# Optional email SMTP (Mailtrap, Gmail SMTP, etc). If empty, server uses Ethereal for dev previews.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Twilio credentials (required for SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=+1XXXXXXXXXX    # your Twilio phone number (E.164 format)

# Comma-separated crew phone numbers (E.164). Order corresponds to roles below.
CREW_PHONES=+919600156167,+916383138545

# Comma-separated crew emails (optional)
CREW_EMAILS=lp@example.com,cleaning@example.com,rollout@example.com

# Crew role names (comma-separated)
CREW_ROLES=loco-pilot,cleaning,morning-depot-rollout
